# ============================================
# xiaoweimm Backend Environment Template
# ============================================
# Copy this file to .env and fill in your own values
# NEVER commit .env to git!

NODE_ENV=development
PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED - app will crash in production if missing
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database
DB_PATH=./data/xiaoweimm.db
UPLOAD_DIR=./uploads

# CORS - use specific origin in production
CORS_ORIGIN=http://localhost:3002

# SMS
SMS_DEV_MODE=true
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=xiaoweimm
SMS_TEMPLATE_CODE=SMS_XXXXXXX

# WeChat Pay
# 中国大陆微信支付 H5：需商户平台开通 H5 支付，回调必须是公网 HTTPS 域名。
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=https://your-domain.com/api/payments/callback/wechat

# Alipay
# 中国大陆支付宝手机网站支付：需开通「手机网站支付」，RSA2 密钥使用 PEM 格式。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payments/callback/alipay
ALIPAY_RETURN_URL=https://your-domain.com/payment-result

# Manual balance recharge is dangerous. Keep false/empty in production.
PAYMENT_ALLOW_MANUAL_RECHARGE=false
PAYMENT_DEV_AUTO_FUND=false

# ====== OAuth Third-Party Login (fill in to enable) ======
# WeChat Open Platform — https://open.weixin.qq.com
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_SECRET=

# Alipay Open Platform — https://open.alipay.com
ALIPAY_OAUTH_APP_ID=
ALIPAY_OAUTH_PRIVATE_KEY=
